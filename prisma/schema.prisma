// ── Local Document Onboarding Agent ─────────────────────────────────────────
// Foundation only: token-issuance + upload intake. The local agent binary,
// automatic classification job, and brief-assignment review UI are follow-on
// work that build on this contract — nothing here auto-files a document into
// a Brief. IngestionCandidate is a staging row; only DocumentIngestionService
// (the same pipeline every other ingestion source uses) ever creates the real
// Document, and only after a human confirms the Brief assignment.

model IngestionSession {
  id          String    @id @default(cuid())
  workspaceId String
  createdById String
  label       String?
  tokenHash   String    @unique
  status      String    @default("active") // active | expired | revoked
  expiresAt   DateTime
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("IngestionSessionCreator", fields: [createdById], references: [id])
  candidates  IngestionCandidate[]

  @@index([workspaceId, status])
  @@index([tokenHash])
}

model IngestionCandidate {
  id                String    @id @default(cuid())
  sessionId         String
  workspaceId       String
  sourcePath        String    // original relative path/filename on the firm's machine, for reviewer context
  fileName          String
  contentType       String
  size              Int
  blobUrl           String
  checksum          String?   // content hash, for de-duplication across re-runs
  suggestedBriefId  String?   // filled by the follow-on classification job
  confirmedBriefId  String?   // set only when a human confirms in the review UI
  documentId        String?   @unique // set once promoted via DocumentIngestionService
  status            String    @default("pending") // pending | classified | confirmed | rejected | ingested
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?

  session           IngestionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  suggestedBrief    Brief?    @relation("IngestionSuggestedBrief", fields: [suggestedBriefId], references: [id], onDelete: SetNull)
  confirmedBrief    Brief?    @relation("IngestionConfirmedBrief", fields: [confirmedBriefId], references: [id], onDelete: SetNull)
  document          Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([sessionId, status])
  @@index([workspaceId, status])
}

// ── Meeting recording (Meetings & Calendar) ─────────────────────────────────
// A recording captured against a specific CalendarEntry (type: MEETING) — the
// "each day you can record a meeting, save it, and pull out the transcript"
// feature. Transcription is a follow-on step (Whisper API): transcriptStatus
// stays 'pending' until that's wired in, this pass only captures and stores
// the audio.
model MeetingRecording {
  id               String    @id @default(cuid())
  calendarEntryId  String
  audioUrl         String
  durationSeconds  Int?
  transcriptStatus String    @default("pending") // pending | processing | completed | failed
  transcriptText   String?
  createdById      String
  createdAt        DateTime  @default(now())

  calendarEntry    CalendarEntry @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  createdBy        User          @relation("MeetingRecordingCreator", fields: [createdById], references: [id])

  @@index([calendarEntryId])
}

// Every document that arrives via email or WhatsApp lands here, whether the
// AI could confidently tell which brief it belongs to or not. High-confidence
// matches get auto-filed immediately (status becomes 'filed' right away,
// documentId set) but still keep a row here for visibility/audit. Low-
// confidence ones stay 'pending' — the file is downloaded and stored right
// away, nothing is ever discarded or bounced back to the sender — until a
// human confirms which brief it actually belongs to. This directly replaces
// the old failure mode where an unmatched email attachment (or a WhatsApp
// document with no confident case match) was either invisible (no Document
// ever created, only a bare EmailAttachment row nobody thought to check) or
// discarded outright.
model InboxAttachment {
  id                  String    @id @default(cuid())
  workspaceId         String
  source              String    // 'email' | 'whatsapp'
  fileName            String
  blobUrl             String
  contentType         String
  size                Int
  caption             String?   // WhatsApp caption or email subject — the routing text
  inboundEmailId      String?
  whatsappFromNumber  String?
  createdById         String?
  suggestedBriefId    String?
  suggestedConfidence Float?
  suggestedReasoning  String?
  confirmedBriefId    String?
  documentId          String?   @unique
  status              String    @default("pending") // pending | filed
  createdAt           DateTime  @default(now())
  filedAt             DateTime?

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inboundEmail   InboundEmail? @relation(fields: [inboundEmailId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("InboxAttachmentCreator", fields: [createdById], references: [id])
  suggestedBrief Brief?        @relation("InboxAttachmentSuggestedBrief", fields: [suggestedBriefId], references: [id], onDelete: SetNull)
  confirmedBrief Brief?        @relation("InboxAttachmentConfirmedBrief", fields: [confirmedBriefId], references: [id], onDelete: SetNull)
  document       Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([source])
  @@index([inboundEmailId])
}
