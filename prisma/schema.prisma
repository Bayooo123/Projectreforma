generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model Workspace {
  id                String                @id @default(cuid())
  /// @searchable
  name              String
  /// @searchable
  slug              String                @unique
  ownerId           String
  plan              String                @default("free")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  /// @searchable
  firmCode          String?               @unique
  joinPassword      String?
  letterheadUrl     String?
  revenuePin        String?
  inviteLinkToken   String?               @unique
  litigationPin     String?
  adminCode         String?
  officeManagerPin  String?
  itManagementPin   String?
  compliancePin     String?
  accentColor       String?               @default("#3182ce")
  brandColor        String?               @default("#121826")
  brandingCompleted Boolean               @default(false)
  secondaryColor    String?               @default("#1e293b")
  geofenceEnabled   Boolean               @default(false)
  geofenceLat       Float?
  geofenceLng       Float?
  geofenceRadius    Int                   @default(150)
  geofenceAddress   String?
  subscriptionStatus    String    @default("free")
  subscriptionBand      String?
  subscriptionTier      String?
  subscriptionExpiresAt DateTime?
  subscriptionStartedAt DateTime?
  bankAccounts          BankAccount[]
  briefs                Brief[]
  clients               Client[]
  complianceTasks       ComplianceTask[]
  draftingTemplates     DraftingTemplate[]
  expenses              Expense[]
  invitations           Invitation[]
  matters               Matter[]
  tasks                 Task[]
  inboundEmails         InboundEmail[]
  activityLogs          WorkspaceActivityLog[]
  attendanceRecords     AttendanceRecord[]
  matterQuestions       MatterQuestion[]
  anomalies             WorkspaceAnomaly[]
  owner                 User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  emailConfig           WorkspaceEmailConfig?
  members               WorkspaceMember[]
  workEntries           WorkEntry[]
  litigationMilestones  LitigationMilestone[]
  subscriptionPayments  SubscriptionPayment[]
  firmContacts          FirmContact[]
  pulseEvents           PulseEvent[]
  modulePinResets       ModulePinReset[]
  whatsappSessions      WhatsappSession[]
  agentInsights         AgentInsight[]
  ingestionSessions     IngestionSession[]
  inboxAttachments      InboxAttachment[]

  @@index([slug])
  @@index([firmCode])
}

model WorkspaceMember {
  id           String             @id @default(cuid())
  workspaceId  String
  userId       String
  role         String
  joinedAt     DateTime           @default(now())
  designation  String?
  status       String             @default("active")
  isGuest      Boolean            @default(false)
  canDownload  Boolean            @default(true)
  canDelete    Boolean            @default(false)
  expiresAt    DateTime?
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  briefGrants  BriefAccessGrant[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([isGuest])
}

model BriefAccessGrant {
  id               String          @id @default(cuid())
  memberId         String
  briefId          String
  grantedBy        String
  createdAt        DateTime        @default(now())
  member           WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  brief            Brief           @relation(fields: [briefId], references: [id], onDelete: Cascade)
  grantedByUser    User            @relation(fields: [grantedBy], references: [id])

  @@unique([memberId, briefId])
  @@index([memberId])
  @@index([briefId])
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  invitedById String
  status      String    @default("pending")
  tokenHash   String    @unique
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  invitedBy   User      @relation(fields: [invitedById], references: [id])

  @@index([tokenHash])
  @@index([email])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        String
  invitedBy   String
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  ipAddress   String?
  revokedAt   DateTime?
  tokenHash   String    @unique
  userAgent   String?
  inviter     User      @relation(fields: [invitedBy], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([email])
}

model User {
  id                     String                 @id @default(cuid())
  /// @searchable
  name                   String?
  /// @searchable
  email                  String                 @unique
  password               String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  emailVerified          DateTime?
  phone                  String?
  image                  String?
  jobTitle               String?
  lawyerToken            String?                @unique
  isPlatformAdmin        Boolean                @default(false)
  mfaEnabled             Boolean?               @default(false)
  mfaSecret              String?
  accounts               Account[]
  apiKeys                ApiKey[]
  createdBriefs          Brief[]                @relation("BriefCreator")
  briefsInCharge         Brief[]                @relation("LawyerInCharge")
  BriefActivityLog       BriefActivityLog[]
  briefLawyerChanges     BriefLawyerHistory[]   @relation("BriefLawyerChanges")
  briefAssignments       BriefLawyer[]          @relation("BriefLawyerUser")
  clientCommunications   ClientCommunication[]
  complianceHistory      ComplianceHistory[]
  acknowledgedCompliance ComplianceTask[]       @relation("AcknowledgedBy")
  draftingSessions       DraftingSession[]
  draftingTemplates      DraftingTemplate[]
  emailVerifications     EmailVerification[]
  expenseAuditLogs       ExpenseAuditLog[]
  invitations            Invitation[]
  adminInvites           AdminInvite[]
  mattersInCharge        Matter[]               @relation("MatterLawyerInCharge")
  activityLogs           MatterActivityLog[]
  matterLawyer           MatterLawyer[]

  passwordResetRequests  PasswordResetRequest[]
  securityAuditLogs      SecurityAuditLog[]
  sessions               Session[]
  createdTasks           Task[]                 @relation("CreatedTasks")
  assignedTasks          Task[]                 @relation("AssignedTasks")
  sessionVersion         Int                    @default(0)
  ownedWorkspaces        Workspace[]            @relation("WorkspaceOwner")
  workspaces             WorkspaceMember[]
  grantedBriefAccess     BriefAccessGrant[]
  userSessions           UserSession[]
  workspaceActivity      WorkspaceActivityLog[]
  attendanceRecords      AttendanceRecord[]
  calendarAppearances          CalendarEntry[]        @relation("CalendarAppearances")
  answeredMatterQuestions      MatterQuestion[]       @relation("MatterQuestionAnsweredBy")
  resolvedAnomalies            WorkspaceAnomaly[]     @relation("AnomalyResolver")
  pushSubscriptions            PushSubscription[]
  workEntries                  WorkEntry[]            @relation("UserWorkEntries")
  createdWorkEntries           WorkEntry[]            @relation("WorkEntryCreator")
  pulseEventAssignments        PulseEvent[]           @relation("PulseEventAssignee")
  createdIngestionSessions     IngestionSession[]     @relation("IngestionSessionCreator")
  manualBriefStatusUpdates     Brief[]                @relation("BriefManualStatusUpdater")
  createdMeetingRecordings     MeetingRecording[]     @relation("MeetingRecordingCreator")
  createdInboxAttachments      InboxAttachment[]      @relation("InboxAttachmentCreator")

  // Personal theme overrides
  themeSource          String?  @default("workspace")
  personalAccentColor  String?
  personalSecondaryColor String?
  personalBrandColor   String?

  @@index([email])
  @@index([lawyerToken])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BankAccount {
  id            String    @id @default(cuid())
  workspaceId   String
  bankName      String
  accountNumber String
  accountName   String
  currency      String    @default("NGN")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSession {
  id             String    @id @default(cuid())
  userId         String
  jti            String    @unique
  sessionVersion Int       @default(0)
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@index([expiresAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Notification {
  id                      String          @id @default(cuid())
  type                    String
  title                   String
  message                 String
  recipientId             String
  recipientType           String
  relatedMatterId         String?
  relatedBriefId          String?
  relatedComplianceTaskId String?
  priority                String          @default("medium")
  status                  String          @default("unread")
  channels                String?
  createdAt               DateTime        @default(now())
  readAt                  DateTime?
  metadata                Json?
  relatedInvoiceId        String?
  relatedPaymentId        String?
  updatedAt               DateTime        @updatedAt
  brief                   Brief?          @relation(fields: [relatedBriefId], references: [id])
  complianceTask          ComplianceTask? @relation(fields: [relatedComplianceTaskId], references: [id])
  invoice                 Invoice?        @relation(fields: [relatedInvoiceId], references: [id])
  matter                  Matter?         @relation(fields: [relatedMatterId], references: [id])
  payment                 Payment?        @relation(fields: [relatedPaymentId], references: [id])

  @@index([recipientId, status])
  @@index([createdAt])
}

model NotificationRule {
  id          String   @id @default(cuid())
  name        String
  description String?
  triggerType String
  conditions  String
  actions     String
  enabled     Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

model Matter {
  id                    String                @id @default(cuid())
  /// @searchable
  caseNumber            String?               @unique
  /// @searchable
  name                  String
  clientId              String?
  clientNameRaw         String?
  workspaceId           String
  court                 String?
  judge                 String?
  status                String                @default("active")
  nextCourtDate         DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  lastActivityAt        DateTime              @default(now())
  lastClientContact     DateTime?
  submittingLawyerId    String?
  submittingLawyerToken String?
  submittingLawyerName  String?
  lawyerInChargeId      String?
  opponentCounsel       String?
  opponentName          String?
  briefs                Brief[]
  calendarEntries       CalendarEntry[]
  clientCommunications  ClientCommunication[]
  inboundEmails         InboundEmail[]
  invoices              Invoice[]
  client                Client?               @relation(fields: [clientId], references: [id])
  lawyerInCharge        User?                 @relation("MatterLawyerInCharge", fields: [lawyerInChargeId], references: [id])
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activityLogs          MatterActivityLog[]
  lawyers               MatterLawyer[]

  notifications         Notification[]
  tasks                 Task[]
  matterQuestions       MatterQuestion[]
  litigationMilestones  LitigationMilestone[]
  pulseEvents           PulseEvent[]

  @@index([workspaceId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([nextCourtDate])
  @@index([submittingLawyerId])
  @@index([deletedAt])
  @@index([workspaceId, status, deletedAt])
}

model MatterLawyer {
  id          String  @id @default(cuid())
  matterId    String
  lawyerId    String
  role        String
  isAppearing Boolean @default(false)
  lawyer      User    @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  matter      Matter  @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, lawyerId])
  @@index([lawyerId])
  @@index([matterId])
}

model CalendarEntry {
  id                     String                  @id(map: "CourtDate_pkey") @default(cuid())
  matterId               String?
  date                   DateTime
  title                  String?
  proceedings            String?
  outcome                String?
  adjournedFor           String?
  adjournedTo            DateTime?
  submittingLawyerId     String?
  submittingLawyerToken  String?
  submittingLawyerName   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  briefId                String?
  clientId               String?
  externalCounsel        String?
  judge                  String?
  court                  String?
  location               String?
  agenda                 String?
  description            String?
  type                   CalendarEventType?      @default(COURT)
  deletedAt              DateTime?
  deletedById            String?
  matter                 Matter?                 @relation(fields: [matterId], references: [id], onDelete: Cascade, map: "CourtDate_matterId_fkey")
  brief                  Brief?                  @relation(fields: [briefId], references: [id], onDelete: SetNull)
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  scheduledNotifications ScheduledNotification[]
  appearances            User[]                  @relation("CalendarAppearances")
  matterQuestions        MatterQuestion[]
  recordings             MeetingRecording[]

  @@index([briefId], map: "CourtDate_briefId_idx")
  @@index([clientId], map: "CourtDate_clientId_idx")
  @@index([date], map: "CourtDate_date_idx")
  @@index([matterId], map: "CourtDate_matterId_idx")
  @@index([submittingLawyerId], map: "CourtDate_submittingLawyerId_idx")
  @@index([type], map: "CourtDate_type_idx")
  @@index([type, date])
}

model ScheduledNotification {
  id               String          @id @default(cuid())
  matterId         String?
  complianceTaskId String?
  recipientId      String
  notificationType String
  scheduledFor     DateTime
  status           String          @default("pending")
  sentAt           DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  calendarEntryId  String?
  calendarEntry    CalendarEntry?  @relation(fields: [calendarEntryId], references: [id], onDelete: Cascade)
  complianceTask   ComplianceTask? @relation(fields: [complianceTaskId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([matterId])
  @@index([calendarEntryId])
  @@index([complianceTaskId])
  @@index([recipientId])
}

model MatterActivityLog {
  id           String   @id @default(cuid())
  matterId     String
  activityType String
  description  String
  performedBy  String
  timestamp    DateTime @default(now())
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [performedBy], references: [id])

  @@index([matterId, timestamp])
}

model ClientCommunication {
  id                String   @id @default(cuid())
  matterId          String
  clientId          String
  communicationType String
  subject           String
  summary           String
  sentBy            String
  sentAt            DateTime @default(now())
  client            Client   @relation(fields: [clientId], references: [id])
  matter            Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [sentBy], references: [id])

  @@index([matterId])
  @@index([clientId])
  @@index([sentAt])
}

model Brief {
  id                  String               @id @default(cuid())
  /// @searchable
  briefNumber         String               @unique
  /// @searchable
  name                String
  clientId            String?
  matterId            String?
  lawyerId            String
  workspaceId         String
  category            String
  status              String               @default("active")
  dueDate             DateTime?
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inboundEmailId      String               @unique @default(uuid())
  customBriefNumber   String?              @unique
  customTitle         String?
  isLitigationDerived Boolean              @default(false)
  lawyerInChargeId    String?
  deletedAt           DateTime?
  briefId             String?
  parentBriefId       String?
  aiSummaryProse      String?
  aiSummaryChronology Json?
  aiSummaryGeneratedAt DateTime?
  manualStatus          String?
  manualNextAction      String?
  manualStatusUpdatedAt DateTime?
  manualStatusUpdatedById String?
  manualStatusUpdatedBy  User?              @relation("BriefManualStatusUpdater", fields: [manualStatusUpdatedById], references: [id])
  parentBrief         Brief?               @relation("BriefHierarchy", fields: [parentBriefId], references: [id])
  subBriefs           Brief[]              @relation("BriefHierarchy")
  client              Client?              @relation(fields: [clientId], references: [id])
  lawyer              User                 @relation("BriefCreator", fields: [lawyerId], references: [id])
  lawyerInCharge      User?                @relation("LawyerInCharge", fields: [lawyerInChargeId], references: [id])
  matter              Matter?              @relation(fields: [matterId], references: [id])
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activityLogs        BriefActivityLog[]
  lawyerChanges       BriefLawyerHistory[]
  calendarEntries     CalendarEntry[]
  documents           Document[]
  notifications       Notification[]
  tasks               Task[]
  folders             Folder[]
  accessGrants        BriefAccessGrant[]
  workEntries         WorkEntry[]
  briefLawyers        BriefLawyer[]
  timelineEvents      DocumentTimelineEvent[]
  pulseEvents         PulseEvent[]
  agentInsights       AgentInsight[]
  suggestedIngestionCandidates IngestionCandidate[] @relation("IngestionSuggestedBrief")
  confirmedIngestionCandidates IngestionCandidate[] @relation("IngestionConfirmedBrief")
  suggestedInboxAttachments    InboxAttachment[]    @relation("InboxAttachmentSuggestedBrief")
  confirmedInboxAttachments    InboxAttachment[]    @relation("InboxAttachmentConfirmedBrief")

  @@index([lawyerId])
  @@index([lawyerInChargeId])
  @@index([workspaceId])
  @@index([clientId])
  @@index([matterId])
  @@index([parentBriefId])
  @@index([dueDate])
  @@index([status])
  @@index([deletedAt])
  @@index([isLitigationDerived])
  @@index([workspaceId, status, deletedAt])
}

model Document {
  id         String          @id @default(cuid())
  name       String
  url        String
  type       String
  size       Int
  briefId    String
  folderId   String?
  uploadedAt DateTime        @default(now())
  ocrStatus  String          @default("pending")
  ocrText    String?
  docType    String?         // classification: Motion, Order, Opinion, etc.
  versionOfId String?        // Link to the parent document this version supersedes
  version    Int             @default(1)
  versionOf  Document?       @relation("DocumentVersions", fields: [versionOfId], references: [id])
  versions   Document[]      @relation("DocumentVersions")
  brief          Brief                  @relation(fields: [briefId], references: [id], onDelete: Cascade)
  folder         Folder?                @relation(fields: [folderId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]
  timelineEvents DocumentTimelineEvent[]
  ingestionCandidate IngestionCandidate?
  inboxAttachment    InboxAttachment?

  @@index([briefId])
  @@index([folderId])
  @@index([versionOfId])
}

model Folder {
  id          String     @id @default(cuid())
  name        String
  description String?
  briefId     String
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  brief       Brief      @relation(fields: [briefId], references: [id], onDelete: Cascade)
  parent      Folder?    @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]   @relation("Subfolders")
  documents   Document[]

  @@index([briefId])
  @@index([parentId])
}

model DocumentChunk {
  id         String                 @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector")?
  chunkIndex Int
  metadata   Json?
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model DocumentTimelineEvent {
  id           String    @id @default(cuid())
  briefId      String
  documentId   String
  documentName String
  eventDate    DateTime?
  eventDateRaw String
  description  String
  createdAt    DateTime  @default(now())

  brief    Brief    @relation(fields: [briefId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([briefId])
  @@index([documentId])
  @@index([eventDate])
  @@index([briefId, eventDate])
}

model Client {
  id                   String                @id @default(cuid())
  /// @searchable
  name                 String
  /// @searchable
  email                String                @unique
  phone                String?
  /// @searchable
  company              String?
  industry             String?
  status               String                @default("active")
  workspaceId          String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  briefs               Brief[]
  calendarEntries      CalendarEntry[]
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientCommunications ClientCommunication[]
  inboundEmails        InboundEmail[]
  invoices             Invoice[]
  matters              Matter[]
  payments             Payment[]
  firmContacts         FirmContact[]

  @@index([email])
  @@index([workspaceId])
  @@index([status])
  @@index([deletedAt])
}

model Invoice {
  id                   String         @id @default(cuid())
  /// @searchable
  invoiceNumber        String         @unique
  clientId             String
  matterId             String?
  date                 DateTime       @default(now())
  dueDate              DateTime?
  status               String         @default("pending")
  billToName           String
  billToAddress        String?
  billToCity           String?
  billToState          String?
  attentionTo          String?
  notes                String?
  subtotal             Decimal        @default(0) @db.Decimal(20, 2)
  vatRate              Float          @default(7.5)
  vatAmount            Decimal        @default(0) @db.Decimal(20, 2)
  securityChargeRate   Float          @default(1.0)
  securityChargeAmount Decimal        @default(0) @db.Decimal(20, 2)
  totalAmount          Decimal        @default(0) @db.Decimal(20, 2)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  followUpSent         Boolean        @default(false)
  client               Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  matter               Matter?        @relation(fields: [matterId], references: [id])
  items                InvoiceItem[]
  notifications        Notification[]
  payments             Payment[]

  @@index([clientId])
  @@index([matterId])
  @@index([status])
  @@index([date])
  @@index([clientId, status])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  amount      Decimal  @db.Decimal(20, 2)
  quantity    Int      @default(1)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String         @id @default(cuid())
  clientId      String
  invoiceId     String?
  amount        Decimal        @db.Decimal(20, 2)
  date          DateTime       @default(now())
  method        String
  reference     String?
  createdAt     DateTime       @default(now())
  notifications Notification[]
  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])

  @@index([clientId])
  @@index([invoiceId])
  @@index([clientId, date])
}

model SubscriptionPayment {
  id               String    @id @default(cuid())
  workspaceId      String
  amount           Float
  band             String
  tier             String
  paymentReference String    @unique
  monnifyReference String    @default("")
  status           String    @default("pending")
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
