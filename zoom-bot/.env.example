# Copy this file to .env and fill in real values. .env itself is gitignored
# (it holds a real API key) — never commit it.

# Reforma's URL and an API key generated for this bot (Settings > API
# Integrations in Reforma, or ask whoever manages the account to run
# scripts/generate-email-sync-api-key.ts <your-email> "Zoom join-bot" for you).
REFORMA_API_URL=https://reforma.ng
REFORMA_API_KEY=

# How often (ms) to check Reforma for a new join request when idle.
POLL_INTERVAL_MS=15000

# Display name the bot uses when joining a meeting.
BOT_DISPLAY_NAME=Reforma Recorder

# The exact name of the VB-Cable recording device, as ffmpeg/Windows see it.
# Default is correct for a standard VB-Cable install — only change this if
# `ffmpeg -list_devices true -f dshow -i dummy` shows a different name.
AUDIO_DEVICE_NAME=CABLE Output (VB-Audio Virtual Cable)

# false = a visible browser window (recommended until you've confirmed the
# bot can join and be admitted reliably). Switch to true once it's proven out.
BOT_HEADLESS=false
