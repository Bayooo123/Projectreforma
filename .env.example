# Database
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Authentication
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI (Anthropic) — required for email triage, brief AI summaries, email routing
ANTHROPIC_API_KEY=sk-ant-...

# AI (OpenAI) — optional. When set, the WhatsApp Brief Manager uses OpenAI as
# its primary provider and falls back to Anthropic on error; when unset, it
# runs on Anthropic alone (today's behavior). Other AI surfaces are still
# Anthropic-only.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Cron Jobs
CRON_SECRET="generate-with-openssl-rand-base64-32"

# BICA Integration
# Set to 'true' in development to easily test BICA execute route without HMAC
# MUST BE omitted or set to 'false' in production
BICA_DISABLE_HMAC="false"