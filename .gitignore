# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local debug/analysis output (do not commit ad-hoc scratch artifacts)
/*.log
/*_output*.txt
/*_errors*.txt
/scratch/
/tmp/

# local-only data for one-off scripts (may contain real names/contact info — this repo is public)
*.local.json
*.local.ts

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# zoom-bot (standalone package, its own node_modules/lockfile, run locally)
/zoom-bot/node_modules
/zoom-bot/*.wav
/zoom-bot/*.m4a
